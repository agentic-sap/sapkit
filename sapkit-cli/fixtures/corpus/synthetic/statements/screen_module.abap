REPORT zdemo_cov_screen.

DATA gv_ok_code TYPE sy-ucomm.
DATA gv_stamp TYPE t.

CALL SCREEN 0100.

MODULE status_0100 OUTPUT.
  SET PF-STATUS 'STAT0100'.
  SET TITLEBAR 'TITLE0100'.
ENDMODULE.

MODULE user_command_0100 INPUT.
  CASE gv_ok_code.
    WHEN 'BACK'.
      LEAVE TO SCREEN 0.
    WHEN 'CALL'.
      CALL TRANSACTION 'SE38'.
    WHEN 'JUMP'.
      LEAVE TO TRANSACTION 'SE38'.
    WHEN OTHERS.
      LEAVE PROGRAM.
  ENDCASE.
ENDMODULE.

CALL SELECTION-SCREEN 1000.
GET TIME FIELD gv_stamp.
