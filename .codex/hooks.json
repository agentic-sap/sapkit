{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,runpy,subprocess; root=subprocess.check_output(['git','rev-parse','--show-toplevel'],encoding='utf-8').strip(); os.environ['CLAUDE_PROJECT_DIR']=root; runpy.run_path(os.path.join(root,'.claude','hooks','stop-quality-gate.py'),run_name='__main__')\"",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,runpy,subprocess; root=subprocess.check_output(['git','rev-parse','--show-toplevel'],encoding='utf-8').strip(); os.environ['CLAUDE_PROJECT_DIR']=root; runpy.run_path(os.path.join(root,'.claude','hooks','block-dangerous-bash.py'),run_name='__main__')\""
          }
        ]
      }
    ]
  }
}
