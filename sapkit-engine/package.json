{
  "name": "sapkit-engine",
  "version": "1.1.1",
  "private": true,
  "description": "SAPKIT 자체 저작 ABAP MCP 엔진 — 청사진 사다리 ⑴. 2026-08-19 판7-b에서 제품 번들 자리를 넘겨받았다(D-095). npm 레지스트리에는 발행하지 않는다 — 제품은 tools/bundle.mjs가 만든 단일 파일을 interactive/server/server.bundle.cjs로 동봉하므로 설치가 완전 오프라인이다. 그래서 private.",
  "license": "MIT",
  "author": "hjaewon",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build": "tsc -p tsconfig.json",
    "test": "jest --passWithNoTests",
    "test:report": "jest --json --outputFile=.jest-report.json",
    "evidence:contract": "node harness/contract-evidence.mjs --jest=.jest-report.json",
    "ledger": "node harness/render-ledger.mjs",
    "gates": "node gates/run-all.mjs",
    "verify": "npm run build:bundle && npm run typecheck && npm test",
    "bundle": "node tools/bundle.mjs",
    "build:bundle": "npm run build && npm run bundle"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "fast-xml-parser": "^5.4.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.5",
    "esbuild": "^0.28.2",
    "jest": "^30.2.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/harness"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "maxWorkers": 1,
    "testTimeout": 30000,
    "clearMocks": true
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  }
}
